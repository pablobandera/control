# Copia este archivo como ".env" (en esta misma carpeta, backend/.env) y completa tus datos reales.
# backend/.env NUNCA se sube al repositorio (ver .gitignore).

APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appjuan
DB_USER=appjuan
DB_PASS=

# Dejalo vacio si el frontend y la API se sirven desde el mismo dominio (recomendado).
# Si los servis desde dominios distintos, poné acá el origen exacto del frontend, por ejemplo:
# FRONTEND_ORIGIN=https://www.tudominio.com
FRONTEND_ORIGIN=
