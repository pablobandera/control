# Copiá este archivo como ".env" (en esta misma carpeta, backend/.env).
# backend/.env NUNCA se sube al repositorio (ver .gitignore).
#
# Tiene dos bloques: LOCALHOST y PRODUCCIÓN. Dejá activo (sin #) solo el
# bloque que corresponda a donde estás corriendo el proyecto, y comentá
# el otro (poniendo # al inicio de cada una de sus líneas).

# ============================================================
# BLOQUE LOCALHOST (tu PC) — activo por defecto
# ============================================================
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appjuan
DB_USER=root
DB_PASS=root

FRONTEND_ORIGIN=http://localhost:5500

# ============================================================
# BLOQUE PRODUCCIÓN (tu hosting) — comentado
# Completá con los datos reales de tu panel de hosting (host, nombre de
# base, usuario y contraseña de MySQL) y descomentá estas líneas cuando
# subas el proyecto. No te olvides de comentar el bloque LOCALHOST de
# arriba para que quede uno solo activo.
# ============================================================
# APP_DEBUG=false
# APP_TIMEZONE=America/Argentina/Buenos_Aires
#
# DB_HOST=TU_DB_HOST_AQUI
# DB_PORT=3306
# DB_NAME=TU_DB_NAME_AQUI
# DB_USER=TU_DB_USER_AQUI
# DB_PASS=TU_DB_PASS_AQUI
#
# FRONTEND_ORIGIN=https://tudominio.com
